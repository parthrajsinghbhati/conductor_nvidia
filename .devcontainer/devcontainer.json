  "name": "Conductor",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt && test -f .env || cp .env.example .env",
  "remoteEnv": {
    "MOCK_MODE": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
