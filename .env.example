# Optional — mock demo works without an API key (recommended for judges).
# Get a free key at https://build.nvidia.com for live NVIDIA inference.

NVIDIA_API_KEY=
MOCK_MODE=true

# Small model used when Conductor routes steps off the big model (default: fast Llama 3.1 8B on NIM)
# SMALL_MODEL=meta/llama-3.1-8b-instruct

# Nemotron Nano may hang on hosted NIM — not recommended for demos
# SMALL_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
